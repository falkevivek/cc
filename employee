public with sharing class EmployeeControllerNew {



    @AuraEnabled

    public static String saveEmployee(



        String name,

        String employeeId,

        String salary,

        String email,

        String department,

        String joiningDate

    ) {



        try {



            // NAME VALIDATION

            if(String.isBlank(name) ||

               name.trim().length() < 3) {



                return 'Employee name must contain at least 3 characters';

            }



            // EMPLOYEE ID VALIDATION

            Integer empId = Integer.valueOf(employeeId);



            if(empId <= 0) {



                return 'Employee ID must be greater than 0';

            }



            // DUPLICATE CHECK

            List<EmployeeLWC__c> existingEmployees = [



                SELECT Id

                FROM EmployeeLWC__c

                WHERE Employee_ID__c = :empId

                LIMIT 1

            ];



            if(!existingEmployees.isEmpty()) {



                return 'Employee ID already exists';

            }



            // SALARY VALIDATION

            Decimal salaryValue = Decimal.valueOf(salary);



            if(salaryValue <= 10000 ||

               salaryValue >= 500000) {



                return 'Salary must be between 10,000 and 500,000';

            }



            // EMAIL VALIDATION

            if(String.isBlank(email) ||

               !email.contains('@') ||

               !email.contains('.')) {



                return 'Invalid Email Format';

            }



            // DEPARTMENT VALIDATION

            if(String.isBlank(department)) {



                return 'Department is required';

            }



            // DATE VALIDATION

            Date joinDate = Date.valueOf(joiningDate);



            if(joinDate > Date.today()) {



                return 'Joining Date cannot be future date';

            }



            // INSERT RECORD

            EmployeeLWC__c emp = new EmployeeLWC__c();



            emp.Name = name;

            emp.Employee_ID__c = empId;

            emp.Salary__c = salaryValue;

            emp.Email__c = email;

            emp.Department__c = department;

            emp.Joining_Date__c = joinDate;



            insert emp;



            return 'Employee Saved Successfully';

        }



        catch(Exception e) {



            return e.getMessage();

        }

    }

}

