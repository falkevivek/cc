Apex Class
public class BankAccountSystem {

    // CREATE CUSTOMER
    public void addCustomer(

        String customerName,
        Decimal customerId,
        String email,
        Date birthDate,
        String department
    ) {

        Bank_Account__c customer =
            new Bank_Account__c();

        customer.Name = customerName;

        customer.Customer_ID__c =
            customerId;

        customer.Email__c = email;

        customer.Birth_Date__c =
            birthDate;

        customer.Department__c =
            department;

        insert customer;

        System.debug(
            'Customer Added Successfully'
        );
    }

    // READ CUSTOMERS
    public void viewCustomers() {

        List<Bank_Account__c> customerList = [

            SELECT Id,
                   Name,
                   Customer_ID__c,
                   Email__c,
                   Birth_Date__c,
                   Department__c

            FROM Bank_Account__c
        ];

        for(Bank_Account__c c :
            customerList) {

            System.debug(

                'Name: ' + c.Name +

                ' | Customer ID: ' +
                c.Customer_ID__c +

                ' | Email: ' +
                c.Email__c +

                ' | Birth Date: ' +
                c.Birth_Date__c +

                ' | Department: ' +
                c.Department__c
            );
        }
    }

    // UPDATE CUSTOMER
    public void updateCustomer(

        Id customerRecordId,
        String newName,
        String newDepartment
    ) {

        Bank_Account__c customer = [

            SELECT Id,
                   Name,
                   Department__c

            FROM Bank_Account__c

            WHERE Id = :customerRecordId

            LIMIT 1
        ];

        customer.Name = newName;

        customer.Department__c =
            newDepartment;

        update customer;

        System.debug(
            'Customer Updated Successfully'
        );
    }

    // DELETE CUSTOMER
    public void deleteCustomer(
        Id customerRecordId
    ) {

        Bank_Account__c customer = [

            SELECT Id

            FROM Bank_Account__c

            WHERE Id = :customerRecordId

            LIMIT 1
        ];

        delete customer;

        System.debug(
            'Customer Deleted Successfully'
        );
    }
}
